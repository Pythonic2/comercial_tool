# MODELO APENAS: este arquivo não é carregado pela aplicação.
# Copie para .env e substitua os valores. Nunca coloque segredos reais aqui.
# Ambiente local direto: development usa db.sqlite3.
DJANGO_ENV=development
DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Em production, configure um PostgreSQL externo (por exemplo, Neon).
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=ALTERE_ESTA_SENHA
DB_HOST=SEU_ENDPOINT-pooler.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_SCHEMA=public
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
SERVE_MEDIA=true

GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
STREAMLIT_DASHBOARD_URL=http://127.0.0.1:8501
